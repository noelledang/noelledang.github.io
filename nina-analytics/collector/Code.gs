// Public write-only collector. Keep the linked Google Sheet private.
const SPREADSHEET_ID = "13OexAsX_0l6_OVr0LpVcwVfMXBg2J2981F2ESut-SXY";
const QUESTIONS_TAB = "Questions"; const EVENTS_TAB = "Events";
const HEADERS = ["id","question","normalized","category","priority","status","occurrences","first_seen","last_seen","notes","type","parent_id","archived","created_at"];
function doPost(e){try{const body=JSON.parse((e&&e.postData&&e.postData.contents)||"{}");if(body.type==="feedback")return saveFeedback_(body);const question=String(body.question||"").trim().replace(/\\s+/g," ").slice(0,1000),normalized=question.toLowerCase().replace(/[^a-z0-9]+/g," ").trim().replace(/\\s+/g," ");if(!normalized)return out_({ok:false});const ss=SpreadsheetApp.openById(SPREADSHEET_ID);let sh=ss.getSheetByName(QUESTIONS_TAB);if(!sh)sh=ss.insertSheet(QUESTIONS_TAB);if(!sh.getLastRow())sh.appendRow(HEADERS);else if(sh.getLastColumn()<HEADERS.length)sh.getRange(1,sh.getLastColumn()+1,1,HEADERS.length-sh.getLastColumn()).setValues([HEADERS.slice(sh.getLastColumn())]);let ev=ss.getSheetByName(EVENTS_TAB);if(!ev){ev=ss.insertSheet(EVENTS_TAB);ev.appendRow(["id","question_id","question","created_at"]);}const data=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,HEADERS.length).getValues():[];const now=new Date();let row=-1,id="";for(let i=0;i<data.length;i++){if(data[i][2]===normalized&&String(data[i][10]||"question")!=="enhancement"&&data[i][12]!==true&&!data[i][11]){row=i+2;id=String(data[i][0]);break;}}if(row<0){id=Utilities.getUuid();sh.appendRow([id,question,normalized,"Uncategorized","Medium","New",1,now,now,"","question","",false,now]);}else{sh.getRange(row,7).setValue(Number(data[row-2][6]||0)+1);sh.getRange(row,9).setValue(now);}ev.appendRow([Utilities.getUuid(),id,question,now]);return out_({ok:true});}catch(err){return out_({ok:false});}}
function saveFeedback_(body){const rating=body.rating==="helpful"?"helpful":body.rating==="not_helpful"?"not_helpful":"";if(!rating)return out_({ok:false});const ss=SpreadsheetApp.openById(SPREADSHEET_ID),name="Answer Feedback",headers=["id","created_at","question","topic_id","topic_title","rating","comment"];let sh=ss.getSheetByName(name);if(!sh){sh=ss.insertSheet(name);sh.appendRow(headers);}else if(!sh.getLastRow())sh.appendRow(headers);sh.appendRow([Utilities.getUuid(),new Date(),String(body.question||"").slice(0,1000),String(body.topic_id||"").slice(0,120),String(body.topic_title||"").slice(0,200),rating,String(body.comment||"").slice(0,2000)]);return out_({ok:true});}
function out_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}
